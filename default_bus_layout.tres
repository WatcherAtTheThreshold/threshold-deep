[gd_resource type="AudioBusLayout" format=3]

; Three buses so Options can offer music and SFX separately. Everything used to
; play on Master; Sfx (both play_at and play_ui) now targets "SFX" and the
; MusicDrift autoload plus the title track target "Music". Scene-embedded
; AudioStreamPlayer3D nodes (creature footsteps, the enemy creak) set their own
; bus in their .tscn — grep `bus = ` if a sound ever ignores the slider.

[resource]
bus/1/name = &"Music"
bus/1/solo = false
bus/1/mute = false
bus/1/bypass_fx = false
bus/1/volume_db = 0.0
bus/1/send = &"Master"
bus/2/name = &"SFX"
bus/2/solo = false
bus/2/mute = false
bus/2/bypass_fx = false
bus/2/volume_db = 0.0
bus/2/send = &"Master"
