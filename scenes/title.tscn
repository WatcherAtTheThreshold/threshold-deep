[node name="Menu" type="VBoxContainer" parent="UI" unique_id=75070979]
visible = false
anchors_preset = -1
anchor_left = 0.5
anchor_top = 0.3
anchor_right = 0.5
anchor_bottom = 0.3
grow_horizontal = 2
grow_vertical = 2
# The stack is centred on anchor_top (grow_vertical is BOTH), so both of these
# move the QUIT plate relative to the planted sword's pommel below it — the two
# were grazing, which is the tangent that reads as a mistake.
# `separation` shortens the block symmetrically: 12 -> 6 lifts Quit's bottom
# edge 6px. `anchor_top` slides the whole block: each +0.01 pushes it ~6.5px
# DOWN toward the sword (0.02 of a 648-unit viewport ≈ 13px). Raise it to
# overlap the pommel decisively, lower it to open a clean gap — either kills
# the tangent, but pick one and commit.
# DECIDED: the gap. Overlapping would read as intentional, but the planted
# sword in torchlight is the shot this whole screen exists for (start-screen.md
# — "nothing has to happen for it to read"), and covering it to prove the UI
# lives in the world trades the picture for the point. Buttons stay clear.
theme_override_constants/separation = 6

